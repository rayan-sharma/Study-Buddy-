# Copy to .env.local and fill in. Server-only: never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini

# Same value as INGEST_SECRET in my-agent/.env.local (the FaceTime voice agent posts transcripts with it).
INGEST_SECRET=

# Chert iMessage (shared line, API only): Console > project > Developer > API keys > Create (allow write).
# Without it, reminders appear in the web app only.
CHERT_API_KEY=
# Optional: otherwise the line matching FACETIME_LINE_ADDRESS (or the first line) is used.
CHERT_LINE_ID=
# Chert allows 10 texts/hour on trial, 100 for the hackathon.
CHERT_MAX_PER_HOUR=10
# The phone verified with `chert onboard` (texts can only go to this number), e.g. +14155551234
DEMO_USER_PHONE=
# The agent's FaceTime line, used in call links. Update it if chert onboard assigns a new number.
FACETIME_LINE_ADDRESS=+16282335326

DATABASE_PATH=data/studybuddy.db
DEMO_TIMEZONE=America/Los_Angeles
DEMO_MODE=true
